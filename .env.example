# ── AegisAI Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegisdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_password@postgres:5432/aegisdb

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Embedding provider (M2+) ──────────────────────────────────────────────────
# Provider: "local" = sentence-transformers (no GPU, no API key required).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Chunking (M2+) ────────────────────────────────────────────────────────────
# Target chunk size in tokens. Measure retrieval quality before tuning.
CHUNK_SIZE=512
CHUNK_OVERLAP=51

# ── Upload limits (M2+) ───────────────────────────────────────────────────────
UPLOAD_MAX_MB=50

# ── Retrieval (M2+) ───────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20

# ── M3: BM25 + RRF + Reranker ────────────────────────────────────────────────
BM25_TOP_K=20
RRF_K=60
RERANKER_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── M3: Evidence threshold & abstention ───────────────────────────────────────
EVIDENCE_THRESHOLD=0.0
MIN_EVIDENCE_CHUNKS=1

# ── LLM provider (M3+) ────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ── Azure (M8+) ───────────────────────────────────────────────────────────────
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_STORAGE_CONNECTION_STRING=

# ── Observability (M7+) ───────────────────────────────────────────────────────
OBSERVABILITY_ENABLED=true
DRIFT_THRESHOLD_PCT=5.0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3010
# PHOENIX_HOST=http://localhost:6006

