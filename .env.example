# ── AegisAI Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegisdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegis:aegis_dev_password@postgres:5432/aegisdb

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Embedding provider (M2+) ──────────────────────────────────────────────────
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM provider (M5+) ────────────────────────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ── Azure (M10) ───────────────────────────────────────────────────────────────
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_STORAGE_CONNECTION_STRING=

# ── Observability (M9) ────────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3010
# PHOENIX_HOST=http://localhost:6006
