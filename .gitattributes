# ── AegisAI — Line endings ────────────────────────────────────────────────────
# Normalize to LF in the repository; Windows checkouts use CRLF for text files.

* text=auto

# Force LF for files that must stay LF (Docker, shell scripts)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binaries — no EOL conversion
*.png       binary
*.jpg       binary
*.pdf       binary
*.whl       binary
